<Window x:Class="WpfSEM02.Views.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Menú Principal" Height="450" Width="700"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Operaciones">
                <MenuItem Header="Ingresos" Click="MenuIngresos_Click"/>
                <MenuItem Header="Salida" Click="MenuSalidas_Click"/>
            </MenuItem>
            <MenuItem Header="Mantenimientos">
                <MenuItem Header="Conductores">
                    <MenuItem Header="Registrar Conductor" Click="MenuConductorRegistro_Click"/>
                    <MenuItem Header="Lista de Conductores" Click="MenuConductorLista_Click"/>
                </MenuItem>
                <MenuItem Header="Transportistas" Click="MenuTransportistas_Click"/>
                <MenuItem Header="Camiones" Click="MenuCamiones_Click"/>
                <MenuItem Header="Productos" Click="MenuProductos_Click"/>
            </MenuItem>
            <MenuItem Header="Reportes">
                <MenuItem Header="Cargas" Click="MenuReporteCargas_Click"/>
                <MenuItem Header="Ingresos" Click="MenuReporteIngresos_Click"/>
                <MenuItem Header="Salidas" Click="MenuReporteSalidas_Click"/>
            </MenuItem>
        </Menu>

        <Grid>
            <TextBlock Text="Bienvenido al sistema de control de ingresos y salidas"
                       FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DockPanel>
</Window>