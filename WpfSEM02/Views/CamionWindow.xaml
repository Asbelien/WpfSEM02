<Window x:Class="WpfSEM02.Views.CamionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camiones" Height="450" Width="650"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Camiones" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Placa:" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="txtPlaca" Grid.Column="1" Margin="0,0,10,0"/>

            <TextBlock Text="Marca:" Grid.Column="2" VerticalAlignment="Center"/>
            <TextBox x:Name="txtMarca" Grid.Column="3" Margin="0,0,10,0"/>

            <TextBlock Text="Modelo:" Grid.Column="4" VerticalAlignment="Center"/>
            <TextBox x:Name="txtModelo" Grid.Column="5" Margin="0,0,10,0"/>

            <TextBlock Text="Transporte:" Grid.Column="6" VerticalAlignment="Center"/>
            <TextBox x:Name="txtTransporte" Grid.Column="7" Margin="0,0,10,0"/>

            <Button x:Name="btnGuardar" Content="Guardar" Grid.Column="8" Height="28" Click="btnGuardar_Click"/>
        </Grid>

        <DataGrid x:Name="dgCamiones" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Placa" Binding="{Binding Placa}" Width="*"/>
                <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="*"/>
                <DataGridTextColumn Header="Modelo" Binding="{Binding Modelo}" Width="*"/>
                <DataGridTextColumn Header="Transporte" Binding="{Binding Transporte}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>